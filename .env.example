# Run npm run setup to generate a private .env; never commit real credentials.
BOJI_HOST=127.0.0.1
BOJI_PORT=8787
BOJI_PUBLIC_URL=http://127.0.0.1:8787
# Comma-separated trusted origins retained during a domain migration (same protocol).
BOJI_PUBLIC_URL_ALIASES=
BOJI_DATA_DIR=./data
BOJI_TIMEZONE=Asia/Shanghai
BOJI_ADMIN_PASSWORD=
